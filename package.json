{
  "name": "classqueue",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Classroom music queue: students suggest and vote on songs from Chromebooks, the teacher's music account plays the winners, and a filter keeps it school-appropriate.",
  "license": "MIT",
  "scripts": {
    "dev": "npm run build && wrangler dev --ip 127.0.0.1 --port 8792 --local-upstream 127.0.0.1:8792",
    "dev:web": "vite web",
    "build": "vite build web",
    "deploy": "npm run build && wrangler deploy",
    "test": "node --test \"test/*.test.mjs\"",
    "test:browser": "node test/browser/flows.mjs",
    "test:spotify": "node test/browser/spotify.mjs",
    "test:youtube": "node test/browser/youtube.mjs",
    "test:a11y": "node test/browser/a11y.mjs",
    "test:apple": "node test/browser/apple.mjs",
    "test:student": "node test/browser/student.mjs",
    "test:checks": "node test/browser/checks.mjs",
    "test:downvotes": "node test/browser/downvotes.mjs",
    "test:upvotes": "node test/browser/upvotes.mjs",
    "test:scorefloor": "node test/browser/scorefloor.mjs",
    "test:downvotemode": "node test/browser/downvotemode.mjs",
    "test:ghost": "node test/browser/ghost.mjs",
    "test:catalog": "node test/browser/catalog.mjs",
    "test:relay": "node test/browser/relay.mjs",
    "test:credits": "node test/browser/credits.mjs",
    "test:reasons": "node test/browser/reasons.mjs",
    "test:classtime": "node test/browser/classtime.mjs",
    "test:teacher": "node test/browser/teacher.mjs",
    "test:favorites": "node test/browser/favorites.mjs",
    "test:profiles": "node test/browser/profiles.mjs",
    "test:repeats": "node test/browser/repeats.mjs",
    "test:board": "node test/browser/board.mjs",
    "test:coderace": "node test/browser/coderace.mjs",
    "test:board-signin": "node test/browser/board-signin.mjs",
    "test:lyrics": "node test/browser/lyrics.mjs",
    "test:teacher-suggest": "node test/browser/teacher-suggest.mjs",
    "test:teacher-push": "node test/browser/teacher-push.mjs",
    "test:focus": "node test/browser/focus.mjs",
    "test:bell": "node test/browser/bell.mjs",
    "test:layout": "node test/browser/layout.mjs",
    "test:art": "node test/browser/art.mjs",
    "test:hardening": "node test/browser/hardening.mjs",
    "test:signin": "node test/browser/signin.mjs",
    "icons": "node scripts/make-icons.mjs web/public",
    "stats": "node scripts/stats.mjs"
