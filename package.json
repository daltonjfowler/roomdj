  "devDependencies": {
    "axe-core": "^4.11.0",
    "playwright-core": "^1.56.1",
    "vite": "8.2.2",
    "wrangler": "4.142.0"
  },
  "allowScripts": {
    "workerd@1.20260926.1": true
  }
}
