# What Cloudflare serves WITHOUT the Worker (wrangler.jsonc run_worker_first: everything but the
# pages and /api/): the built JS and CSS, images, robots.txt, and the 404 page for unknown paths.
# The same headers as src/headers.js COMMON_HEADERS + PAGE_CSP (test/headers.test.mjs checks).
# Pages the Worker answers set their own (stricter for /host/, /board/, /admin/).
/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: serial=(), usb=(), camera=(), microphone=(), geolocation=(), payment=(), encrypted-media=(self "https://sdk.scdn.co" "https://www.youtube-nocookie.com"), autoplay=(self "https://sdk.scdn.co" "https://www.youtube-nocookie.com")
  Cross-Origin-Opener-Policy: same-origin
  Content-Security-Policy: default-src 'self'; script-src 'self'; frame-src 'none'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://*.mzstatic.com https://i.scdn.co https://i.ytimg.com; media-src https://*.itunes.apple.com https://*.mzstatic.com https://*.apple.com blob:; connect-src 'self' https://itunes.apple.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests

# Vite names these by their content, so a new build is a new file: browsers keep them a year.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/screens/*
  Cache-Control: public, max-age=86400

/icon.svg
  Cache-Control: public, max-age=86400

/icon-animated.svg
  Cache-Control: public, max-age=86400

/icon-192.png
  Cache-Control: public, max-age=86400

/icon-512.png
  Cache-Control: public, max-age=86400

/favicon-32.png
  Cache-Control: public, max-age=86400

/apple-touch-icon.png
  Cache-Control: public, max-age=86400

/social.jpg
  Cache-Control: public, max-age=86400
